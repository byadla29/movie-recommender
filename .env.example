# Copy to `.env` (git-ignored) and replace every value. Docker Compose reads `.env` automatically.
# Use URL-safe characters only (letters, digits, - _): passwords are embedded in database URLs.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"

# Postgres superuser — used only by the Postgres container to run infra/postgres/init on first start.
POSTGRES_PASSWORD=change-me-superuser

# One login role per service; each can connect only to its own database.
USER_SVC_DB_PASSWORD=change-me-user-svc
CATALOG_SVC_DB_PASSWORD=change-me-catalog-svc
RECO_SVC_DB_PASSWORD=change-me-reco-svc

# Clerk PUBLISHABLE key (pk_test_...), public by design. Needed when Docker BUILDS the
# frontend. The SECRET key does NOT go here: it lives only in frontend/.env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Your Clerk app's address (public). user-service verifies tokens issued by it. It is the
# publishable key decoded:  python -c "import base64,sys; k=sys.argv[1].split('_',2)[2]; print('https://'+base64.b64decode(k+'='*(-len(k)%4)).decode().rstrip('$'))" pk_test_...
CLERK_ISSUER_URL=
