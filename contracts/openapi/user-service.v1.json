{
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PreferencesRequest": {
        "additionalProperties": false,
        "description": "What the client sends. Shape checks only; vocabulary checks happen in the domain.",
        "example": {
          "country_code": "IN",
          "genres": [
            "thriller",
            "drama"
          ],
          "languages": [
            "te",
            "en"
          ],
          "region_code": "IN-AP"
        },
        "properties": {
          "country_code": {
            "description": "ISO 3166-1 alpha-2",
            "pattern": "^[A-Z]{2}$",
            "title": "Country Code",
            "type": "string"
          },
          "genres": {
            "description": "Genre slugs, any order",
            "items": {
              "pattern": "^[a-z]+(-[a-z]+)*$",
              "type": "string"
            },
            "maxItems": 5,
            "title": "Genres",
            "type": "array"
          },
          "languages": {
            "description": "ISO 639-1 codes in order of preference (first = favourite)",
            "items": {
              "pattern": "^[a-z]{2,3}$",
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Languages",
            "type": "array"
          },
          "region_code": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO 3166-2, optional",
            "title": "Region Code"
          }
        },
        "required": [
          "country_code",
          "languages"
        ],
        "title": "PreferencesRequest",
        "type": "object"
      },
      "PreferencesResponse": {
        "properties": {
          "country_code": {
            "title": "Country Code",
            "type": "string"
          },
          "genres": {
            "items": {
              "type": "string"
            },
            "title": "Genres",
            "type": "array"
          },
          "languages": {
            "items": {
              "$ref": "#/components/schemas/RankedLanguage"
            },
            "title": "Languages",
            "type": "array"
          },
          "onboarded_at": {
            "format": "date-time",
            "title": "Onboarded At",
            "type": "string"
          },
          "region_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region Code"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "country_code",
          "region_code",
          "languages",
          "genres",
          "onboarded_at",
          "updated_at"
        ],
        "title": "PreferencesResponse",
        "type": "object"
      },
      "RankedLanguage": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "rank"
        ],
        "title": "RankedLanguage",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "const": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Identity provider session token (JWT)",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
