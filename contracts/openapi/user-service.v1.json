{
  "components": {
    "schemas": {
      "ConsentRequest": {
        "additionalProperties": false,
        "example": {
          "granted": true
        },
        "properties": {
          "granted": {
            "title": "Granted",
            "type": "boolean"
          }
        },
        "required": [
          "granted"
        ],
        "title": "ConsentRequest",
        "type": "object"
      },
      "ConsentResponse": {
        "properties": {
          "granted": {
            "title": "Granted",
            "type": "boolean"
          },
          "purpose": {
            "title": "Purpose",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "purpose",
          "granted",
          "updated_at"
        ],
        "title": "ConsentResponse",
        "type": "object"
      },
      "ConsentsResponse": {
        "properties": {
          "consents": {
            "items": {
              "$ref": "#/components/schemas/ConsentResponse"
            },
            "title": "Consents",
            "type": "array"
          }
        },
        "required": [
          "consents"
        ],
        "title": "ConsentsResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PreferencesRequest": {
        "additionalProperties": false,
        "description": "What the client sends. Shape checks only; vocabulary checks happen in the domain.",
        "example": {
          "country_code": "IN",
          "genres": [
            "thriller",
            "drama"
          ],
          "languages": [
            "te",
            "en"
          ],
          "region_code": "IN-AP"
        },
        "properties": {
          "country_code": {
            "description": "ISO 3166-1 alpha-2",
            "pattern": "^[A-Z]{2}$",
            "title": "Country Code",
            "type": "string"
          },
          "genres": {
            "description": "Genre slugs, any order",
            "items": {
              "pattern": "^[a-z]+(-[a-z]+)*$",
              "type": "string"
            },
            "maxItems": 5,
            "title": "Genres",
            "type": "array"
          },
          "languages": {
            "description": "ISO 639-1 codes in order of preference (first = favourite)",
            "items": {
              "pattern": "^[a-z]{2,3}$",
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Languages",
            "type": "array"
          },
          "region_code": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO 3166-2, optional",
            "title": "Region Code"
          }
        },
        "required": [
          "country_code",
          "languages"
        ],
        "title": "PreferencesRequest",
        "type": "object"
      },
      "PreferencesResponse": {
        "properties": {
          "country_code": {
            "title": "Country Code",
            "type": "string"
          },
          "genres": {
            "items": {
              "type": "string"
            },
            "title": "Genres",
            "type": "array"
          },
          "languages": {
            "items": {
              "$ref": "#/components/schemas/RankedLanguage"
            },
            "title": "Languages",
            "type": "array"
          },
          "onboarded_at": {
            "format": "date-time",
            "title": "Onboarded At",
            "type": "string"
          },
          "region_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region Code"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "country_code",
          "region_code",
          "languages",
          "genres",
          "onboarded_at",
          "updated_at"
        ],
        "title": "PreferencesResponse",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details, as returned by every error response (for OpenAPI docs).",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance",
          "request_id"
        ],
        "title": "Problem",
        "type": "object"
      },
      "RankedLanguage": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "rank"
        ],
        "title": "RankedLanguage",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "const": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Identity provider session token (JWT)",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Profiles, region/language/genre preferences, consents and watchlists.",
    "title": "user-service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness check",
        "tags": [
          "operations"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Not ready"
          }
        },
        "summary": "Readiness check (database reachable, migrations at head)",
        "tags": [
          "operations"
        ]
      }
    },
    "/v1/me": {
      "delete": {
        "description": "Idempotent: deleting an account that is already gone (or never existed) also returns 204, so a retry after a timeout is always safe.",
        "operationId": "delete_me_v1_me_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing, invalid or expired token"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication or database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete my profile and all my user-service data",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/me/consents": {
      "get": {
        "operationId": "get_my_consents_v1_me_consents_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing, invalid or expired token"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication or database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List my consent choices",
        "tags": [
          "consents"
        ]
      }
    },
    "/v1/me/consents/{purpose}": {
      "put": {
        "description": "Idempotent. Withdrawing is as easy as granting: send granted=false.",
        "operationId": "put_my_consent_v1_me_consents__purpose__put",
        "parameters": [
          {
            "description": "What the consent is for",
            "in": "path",
            "name": "purpose",
            "required": true,
            "schema": {
              "const": "personalization_tracking",
              "description": "What the consent is for",
              "title": "Purpose",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing, invalid or expired token"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown purpose or invalid body"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication or database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Grant or withdraw consent for one purpose",
        "tags": [
          "consents"
        ]
      }
    },
    "/v1/me/preferences": {
      "get": {
        "operationId": "get_my_preferences_v1_me_preferences_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreferencesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing, invalid or expired token"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not onboarded yet (no preferences saved)"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication or database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get my preferences",
        "tags": [
          "preferences"
        ]
      },
      "put": {
        "description": "Idempotent: sending the same body again leaves the same preferences. Creates the user record on first call.",
        "operationId": "put_my_preferences_v1_me_preferences_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferencesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreferencesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing, invalid or expired token"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid shape or unsupported code"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication or database temporarily unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create or replace my preferences",
        "tags": [
          "preferences"
        ]
      }
    }
  }
}
