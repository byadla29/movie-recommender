            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Not ready"
          }
        },
        "summary": "Readiness check (database reachable, migrations at head)",
        "tags": [
          "operations"
        ]
