# For `npm run dev` outside Docker. Copy to `.env.local` (git-ignored).
# Server-side only (no NEXT_PUBLIC_ prefix): the browser never calls services directly.
USER_SERVICE_URL=http://127.0.0.1:8001
CATALOG_SERVICE_URL=http://127.0.0.1:8002
RECOMMENDATION_SERVICE_URL=http://127.0.0.1:8003

# Clerk (step 2.6): Dashboard → your app → Configure → API keys (Development instance).
# The publishable key is public; the secret key must never be committed or shared.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me
