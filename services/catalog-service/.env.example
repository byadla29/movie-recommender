# For running this service OUTSIDE Docker (e.g. `uv run uvicorn ...`) against the Compose
# Postgres, which is published on localhost:5433. Copy to `.env` (git-ignored).
SERVICE_NAME=catalog-service
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://catalog_svc:change-me-catalog-svc@127.0.0.1:5433/catalog_db
