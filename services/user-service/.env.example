# For running this service OUTSIDE Docker (e.g. `uv run uvicorn ...`) against the Compose
# Postgres, which is published on localhost:5433. Copy to `.env` (git-ignored).
SERVICE_NAME=user-service
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://user_svc:change-me-user-svc@127.0.0.1:5433/user_db

# Token verification (step 2.3). Leave AUTH_ISSUER empty until you have a Clerk app:
# protected endpoints then answer 503 "Authentication is not configured".
# These are PUBLIC values (no secret here): the issuer URL and where its public keys live.
AUTH_ISSUER=
# AUTH_JWKS_URL=            # default: <AUTH_ISSUER>/.well-known/jwks.json
# AUTH_AUDIENCE=            # only if tokens carry an "aud" claim
# AUTH_AUTHORIZED_PARTIES=["http://127.0.0.1:3000"]   # allowed "azp" (frontend origins)
